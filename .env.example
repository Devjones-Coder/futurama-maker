# Caminho persistente de dados. O host Windows define FUTURAMA_USER_DATA automaticamente.
FUTURAMA_USER_DATA=

# Serviço HTTP local; por padrão tenta 3788 e escolhe porta livre se estiver ocupada.
PORT=3788

# Credencial inicial do painel. Troque após o primeiro acesso em Configurações.
FUTURAMA_ADMIN_USER=admin
FUTURAMA_ADMIN_PASSWORD=123456

# Token IPC local usado somente pelo host Electron para consultar e controlar o serviço.
FUTURAMA_CONTROL_TOKEN=

# O host Windows injeta caminhos dos executáveis empacotados; não use binários globais.
FUTURAMA_FFMPEG=
FUTURAMA_FFPROBE=
